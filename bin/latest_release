#!/bin/bash
git fetch --all
LATEST=$(git branch -r | grep -E 'origin/release/[0-9]+([.-][0-9]+)*$' | sort -V | tail -1 | tr -d ' ' | sed 's/origin\///')
if [[ -z "$LATEST" ]]; then
  echo "No numeric release/ branches found (e.g. release/1.00-02)."
  exit 1
fi
echo "Checking out: $LATEST"
git checkout "$LATEST"
git pull
